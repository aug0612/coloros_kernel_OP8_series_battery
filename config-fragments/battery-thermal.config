# =============================================================================
# battery-thermal.config
# Fragment de configuration kernel — Économie de batterie & limitation thermique
# OnePlus 8 Pro (instantnoodlep) — SM8250 — ColorOS 16
# =============================================================================
#
# Ce fragment est ajouté (append) au defconfig du kernel pendant le build
# (voir .github/workflows/build-battery-thermal.yml, étape "Apply tuning").
# Il n'écrase rien : les options qui existent déjà dans le defconfig d'origine
# sont redéfinies par la dernière occurrence lue par le script kconfig (donc
# celles-ci prennent le dessus).
#
# ⚠️ Honnêteté technique : ces options sont des réglages standards du
# framework cpufreq / thermal / PM du kernel Linux, présents dans la quasi
# totalité des kernels Android récents. Elles activent des gouverneurs et
# mécanismes plus économes et rendent le throttling thermique plus progressif
# et plus agressif. Elles ne remplacent pas un vrai profilage sur l'appareil :
# le gain réel dépend aussi des tables de fréquences et des trip points
# thermiques définis dans le Device Tree (DTS), qui ne sont pas modifiés ici.
# Le README explique comment aller plus loin si besoin.

# --- Gouverneurs CPU : privilégier l'économie d'énergie ---
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_GOV_CONSERVATIVE=y
CONFIG_CPU_FREQ_GOV_POWERSAVE=y
CONFIG_CPU_FREQ_GOV_ONDEMAND=y

# --- Gouverneur DevFreq (bus mémoire / GPU) économe ---
CONFIG_DEVFREQ_GOV_POWERSAVE=y
CONFIG_DEVFREQ_GOV_SIMPLE_ONDEMAND=y

# --- Gestion des wakelocks : éviter que le téléphone reste éveillé inutilement ---
CONFIG_PM_WAKELOCKS=y
CONFIG_PM_WAKELOCKS_LIMIT=0
CONFIG_PM_WAKELOCKS_GC=y
CONFIG_PM_AUTOSLEEP=y

# --- Idle CPU plus agressif (rentrer en veille profonde plus facilement) ---
CONFIG_CPU_IDLE=y
CONFIG_NO_HZ_IDLE=y
CONFIG_NO_HZ_COMMON=y
CONFIG_HIGH_RES_TIMERS=y

# --- Thermique : throttling plus progressif et plus réactif ---
CONFIG_THERMAL=y
CONFIG_THERMAL_GOV_STEP_WISE=y
CONFIG_THERMAL_GOV_POWER_ALLOCATOR=y
CONFIG_THERMAL_DEFAULT_GOV_STEP_WISE=y
CONFIG_THERMAL_WRITABLE_TRIPS=y
CONFIG_THERMAL_EMULATION=n

# --- Désactive les boosts agressifs qui font grimper la conso/chauffe ---
# (input boost = montée brutale de fréquence au moindre tap sur l'écran)
# CONFIG_INPUT_BOOST est laissé activable mais avec une portée réduite si le
# kernel source l'expose ; sinon cette ligne est simplement ignorée au build.
CONFIG_CPU_BOOST_MODULE=n

# --- Autres options énergie standards ---
CONFIG_PM_DEBUG=n
CONFIG_PM_ADVANCED_DEBUG=n
